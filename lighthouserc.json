{
  "ci": {
    "collect": {
      "url": ["http://localhost:3100/", "http://localhost:3100/kaiser", "http://localhost:3100/fadelab", "http://localhost:3100/lune"],
      "startServerCommand": "pnpm start --port 3100",
      "startServerReadyPattern": "Ready in",
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["is-on-https", "redirects-http", "uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lighthouse-report" }
  }
}
