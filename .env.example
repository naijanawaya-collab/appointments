# Copy to .env.local and adjust:  cp .env.example .env.local

# Local Docker Postgres (see docker-compose.yml).
# For Neon, paste the *pooled* connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments

# Better Auth. Generate a secret with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The platform (admin) URL. On Vercel, set it to your production URL.
BETTER_AUTH_URL=http://localhost:3000

# Hostnames that serve the PLATFORM (landing, /login, /admin, /book/[slug]).
# Comma-separated, no ports. Any *.vercel.app host is treated as platform automatically.
# Every other hostname is treated as a tenant's custom domain.
PLATFORM_HOSTS=localhost,127.0.0.1

# Email. Without RESEND_API_KEY, emails are printed to the terminal instead.
# EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Bookings <bookings@yourdomain.com>"

# Optional: bookings allowed per IP per 10 minutes (default 10).
# RATE_LIMIT_BOOKINGS=10

# Used only by `pnpm db:seed` to create the first admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
