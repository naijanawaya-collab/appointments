# Copy to .env.local for local development:   cp .env.example .env.local
# Production values are set in Vercel (Project → Settings → Environment Variables).
# Full walkthrough: docs/SETUP.md

# ── Database ────────────────────────────────────────────────────────────────
# Local: the Docker Postgres from docker-compose.yml.
# Neon: the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointments
# Neon only: the direct (unpooled) string, used for migrations. The Neon
# integration on Vercel sets this automatically.
# DATABASE_URL_UNPOOLED=

# ── Auth & secrets ──────────────────────────────────────────────────────────
# Random, 32+ characters:   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Signs customers' "manage my booking" links. Set it once and NEVER change it
# (changing it breaks every link already emailed). Defaults to BETTER_AUTH_SECRET.
# MANAGE_TOKEN_SECRET=
# Where the admin and sign-in live, e.g. https://app.yourdomain.com
BETTER_AUTH_URL=http://localhost:3000

# ── Platform ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PLATFORM_NAME=Appointments
# Public URL of the landing page, e.g. https://yourdomain.com
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
# Hostnames that are the PLATFORM (comma-separated, no ports). Every other
# hostname is treated as a shop's custom domain. *.vercel.app is always platform.
# Production: yourdomain.com,www.yourdomain.com,app.yourdomain.com
PLATFORM_HOSTS=localhost,127.0.0.1
# Operators (comma-separated emails): create shops at /admin/shops and can
# act as owner of every shop for support.
PLATFORM_ADMIN_EMAILS=admin@example.com
# "Open your storefront" on the landing page emails this address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Shown in the platform's Impressum (required in Austria).
PLATFORM_OPERATOR_NAME=
PLATFORM_OPERATOR_ADDRESS=
PLATFORM_OPERATOR_CITY=Vienna

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are printed to the terminal (dev only).
RESEND_API_KEY=
# A sender on your verified Resend domain. Shops' names are used as the
# display name automatically; replies go to the shop's own email.
EMAIL_FROM="Bookings <bookings@mail.yourdomain.com>"

# ── Photos (Cloudinary) ─────────────────────────────────────────────────────
# Cloudinary → Settings → API Keys. Without these, owners can't upload photos.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Custom domains (optional automation) ────────────────────────────────────
# With these, adding a domain in the admin adds it to Vercel and shows its DNS
# status. Without them, add domains in the Vercel dashboard by hand.
# Token: Vercel → Account Settings → Tokens (scope: your team).
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...

# ── Optional ────────────────────────────────────────────────────────────────
# Bookings allowed per IP per 10 minutes (default 10).
# RATE_LIMIT_BOOKINGS=10

# ── Seeding (pnpm db:seed / pnpm db:seed:prod) ──────────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please
